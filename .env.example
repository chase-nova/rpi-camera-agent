# days-in-a-minute agent — stage environment template.
# Copy to a stage file and fill in real values:
#   cp .env.example .env.test   # Windows dev machine (fake camera, mocked S3)
#   cp .env.example .env.dev    # bench Pi
#   cp .env.example .env.prod   # deployed Pi
# There is NO plain .env. Real stage files are gitignored — only this
# template is committed. NEVER put real secrets here.

# ── Identity (design 15 §6) ──────────────────────────────────────────────────
# A device proves itself with a credential it generates at enrollment,
# stored in CREDENTIAL_FILE. To enroll, put the one-time token from the
# webapp's "Register device" here (or ENROLLMENT_TOKEN=... in
# /boot/firmware/dam-agent.env on the SD card, or run
# `python -m agent.enroll <token>`); it is removed once used.
ENROLLMENT_TOKEN=
# CREDENTIAL_FILE=/var/lib/dam-agent/credential.json
TIMEZONE=Asia/Seoul             # required; IANA tz — drives all local dates/times
# Legacy identity (pre-enrollment fleet only): stable per-device id + the
# long-lived DEVICE_TOKEN below. Ignored once a credential file exists.
DEVICE_ID=
# LOCATION_ID is OPTIONAL since phase 2: the agent-manager assigns locations
# (docs/design/02-agent-manager.md §6). Set it only for offline test stages.
LOCATION_ID=

# ── Upload (ADR-0003: NO AWS credentials on devices) ─────────────────────────
S3_IMAGE_PREFIX=images/
# The agent uploads via presigned URLs from the upload-signer Lambda behind
# DAM_ENDPOINT (default https://device.chase-nova.com; UPLOAD_SIGNER_URL is
# the older name and still accepted).
# DAM_ENDPOINT=https://device.chase-nova.com
# Legacy only: app token (revocable server-side, useless against AWS APIs)
# issued by scripts/aws/issue_device_token.py.
DEVICE_TOKEN=

# ── Capture (defaults shown; see docs/design/01-agent.md §7) ────────────────
VIDEO_MINUTES=1                 # minutes of video per 24 h → 48 s interval
CAPTURE_SIZE=1280,720           # W,H
QUEUE_MAX=64                    # in-memory upload queue bound
VIEWER_PORT=8080                # HTTP viewer/health port; 0 disables
# Night/long exposure ceiling in ms (0 = stock AE, ~66 ms max). Set on
# low-light sensors only (e.g. 5000 on the IMX462); keep well under the
# capture interval. Daytime exposure is unaffected — AE only goes long
# when the scene is dark.
MAX_EXPOSURE_MS=0
# Optional libcamera tuning file (empty = automatic). Set
# "imx219_noir.json" on filterless NoIR modules to fix pink whites.
TUNING_FILE=
# Manual night mode: below ~10 lux the agent disables AE and uses this
# exposure/gain (AE cannot exceed the tuning's ~66 ms shutter ceiling).
# 0 disables. Measured sweet spots: IMX462+F/0.95 -> 1000 ms gain 4;
# IMX477 -> 5000 ms gain 10. Keep exposure well under the 48 s interval.
NIGHT_EXPOSURE_MS=0
NIGHT_GAIN=8
# Optional raw sensor mode "W,H" (empty = automatic). Set 1296,972 on
# OV5647 cameras: their auto-picked 1080p mode crops to 74% of the sensor
# width, narrowing the real FoV (e.g. 75deg lens -> ~45deg effective).
RAW_SIZE=

# ── Local spill cache + clock holdover (docs/design/12-local-cache-save.md §7)
# Frames are written to the SD card only while the uploader is offline and
# replayed (oldest first, deleted after each verified PUT) when the
# connection returns. Online, nothing touches the disk.
CACHE_DIR=/var/cache/dam-agent   # created by provision-pi.sh; must survive reboot
CACHE_MAX_FRAMES=54000           # 30 days at 48 s (~6.8 GB typical, ~10 GB worst)
CACHE_MIN_FREE_MB=512            # evict oldest / stop caching below this free space
CACHE_MAX_AGE_DAYS=30            # discard cached frames older than this at replay
CACHE_KEEP_PROVISIONAL=true      # upload uncorrectable-time frames flagged, not drop
OFFLINE_AFTER_FAILURES=3         # consecutive transport failures before spilling
OFFLINE_PROBE_S=30               # /sign probe cadence while offline
REPLAY_MIN_GAP_S=1.0             # min gap between replay PUTs (~1 frame/s max)
ANCHOR_REFRESH_S=600             # trusted time reading refresh/persist cadence

# ── Remote Wi-Fi setup (docs/design/13-remote-wifi-setup.md §3) ─────────────
# Requested from the device page; the agent adds the profile and switches,
# falling back to the previous Wi-Fi if the new one does not come up.
WIFI_APPLY_TIMEOUT_S=45          # max seconds for `nmcli connection up`
WIFI_FALLBACK_S=30               # grace for NetworkManager's own fallback

# ── Dawn & dusk (docs/design/14-dawn-and-dusk.md §6b) ───────────────────────
# IMX462 night mode switches by solar time (on at sun −4° falling, off at
# −5° rising). Per-site minute offsets when the horizon (mountains,
# buildings) shifts effective light; 0 = the solar defaults.
NIGHT_ON_OFFSET_MIN=0
NIGHT_OFF_OFFSET_MIN=0

# ── Network self-healing (docs/design/12-local-cache-save.md §3) ────────────
# A wedged Wi-Fi radio can sit dead while the AP waits. After this much
# silence (no successful signer round trip) the agent bounces the radio;
# after the longer window it reboots as a last resort (the spill cache
# carries the frames across the boot). 0 disables the stage.
NETWORK_KICK_AFTER_S=600
NETWORK_REBOOT_AFTER_S=3600

# ── Thermal protection (docs/design/02-agent-manager.md §5.2) ────────────────
TEMP_WARN_C=75                  # health badge
TEMP_PAUSE_C=80                 # agent pauses capturing (stays online)
TEMP_RESUME_C=75                # auto-resume at or below this
TEMP_SHUTDOWN_C=85              # sustained (3 reads) → poweroff, IF enabled:
TEMP_SHUTDOWN_ENABLED=false     # keep false on remote/NAT devices!
